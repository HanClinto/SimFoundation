{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/HanClinto/SimFoundation/main/packages/open-iso-gfx/schemas/catalog.schema.json",
  "title": "OpenIsoGfx Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "package", "rigs", "assets"],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "package": {
      "const": "open-iso-gfx"
    },
    "rigs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rig"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "rig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "viewBox", "origin", "joints", "anchors"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "viewBox": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4
        },
        "origin": { "$ref": "#/$defs/point" },
        "joints": {
          "type": "array",
          "items": { "$ref": "#/$defs/joint" },
          "minItems": 1
        },
        "anchors": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/anchor" }
        }
      }
    },
    "joint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pivot"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "parentId": { "type": "string" },
        "pivot": { "$ref": "#/$defs/point" }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jointId", "position"],
      "properties": {
        "jointId": { "type": "string" },
        "position": { "$ref": "#/$defs/point" }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "kind",
        "source",
        "rigId",
        "directions",
        "poses",
        "drawLayer",
        "groups",
        "tintChannels",
        "provenance"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "kind": {
          "enum": ["character-base", "equipment", "held-item", "prop", "structure", "effect"]
        },
        "slot": { "type": "string" },
        "source": { "type": "string", "pattern": "^src/.+\\.svg$" },
        "rigId": { "type": "string" },
        "directions": {
          "type": "array",
          "items": { "enum": ["north-east", "north-west", "south-east", "south-west"] },
          "minItems": 1,
          "uniqueItems": true
        },
        "poses": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true
        },
        "drawLayer": { "type": "integer" },
        "groups": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "minItems": 1,
          "uniqueItems": true
        },
        "tintChannels": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["creators", "source", "license", "original"],
          "properties": {
            "creators": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            },
            "source": { "type": "string" },
            "license": { "type": "string" },
            "original": { "type": "boolean" },
            "notes": { "type": "string" }
          }
        }
      }
    }
  }
}
